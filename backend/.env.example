# ─── Database ───────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/cuteshop_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ─── JWT ────────────────────────────────────────────────
# Generate a unique secret with: openssl rand -base64 32
# JWT_SECRET must be set before the application can start.
JWT_SECRET=

# ─── Admin mặc định (chỉ dùng lần đầu seed DB) ─────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=MatKhauRatManh!2024

# ─── Cloudinary ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_FOLDER=squishy-heaven

# ─── CORS (domain frontend) ─────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://yourshop.vercel.app