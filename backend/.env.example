# ─── Database ───────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/peatea_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ─── JWT ────────────────────────────────────────────────
# Generate a unique secret with: openssl rand -base64 32
# JWT_SECRET must be set before the application can start.
JWT_SECRET=

# ─── Admin mặc định (chỉ dùng lần đầu seed DB) ─────────
ADMIN_EMAIL=admin@yourdomain.com
# Required on first startup with an empty database; use a unique password of at least 12 characters.
ADMIN_PASSWORD=

# ─── Cloudinary ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_FOLDER=squishy-heaven

# ─── CORS (domain frontend) ─────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourshop.vercel.app

# ─── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
